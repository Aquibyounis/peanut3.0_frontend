# Peanut 3.0 Frontend Environment Variables Reference

# Local Development Defaults (Active by default)
VITE_API_URL=http://127.0.0.1:8000/chat
VITE_CONNECT_API_URL=http://localhost:8000/connect

# Production reference (Replace with your hosted backend URLs once deployed)
# VITE_API_URL=https://your-hosted-backend.onrender.com/chat
# VITE_CONNECT_API_URL=https://your-hosted-backend.onrender.com/connect
